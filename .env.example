# GROQ_API_KEY: Optional real Groq API key for calibration runs.
# If omitted, the system seamlessly runs on the calibrated StandinProvider.
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GROQ_MODEL: Target hosted model (default: llama-3.1-8b-instant)
GROQ_MODEL="llama-3.1-8b-instant"

# GEMINI_API_KEY: Injected by AI Studio runtime if server-side Gemini features are utilized
GEMINI_API_KEY=""

# APP_URL: Cloud Run / deployment host URL
APP_URL="http://localhost:3000"
